# VideoLab Environment Configuration

# Service Ports & Host
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Queue (Docker Compose defaults)
DATABASE_URL=postgresql://videolab:videolab_secret@localhost:5432/videolab
REDIS_URL=redis://localhost:6379

# Third-Party Generative AI Providers (Optional for Dev Mock)
RUNWAY_API_KEY=
GOOGLE_AI_API_KEY=
